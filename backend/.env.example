# --- Datos compartidos con la app de escritorio ---
# Por defecto se usan config.json y xubio_credenciales.json de la raiz del proyecto.
# CONFIG_CLIENTES=C:/ruta/config.json
# CREDENCIALES_XUBIO=C:/ruta/xubio_credenciales.json
# Carpeta de salida por defecto (en la computadora del servidor).
# CARPETA_SALIDA=C:/Users/<usuario>/Downloads
# Segundos de la pausa entre clientes antes de seguir sola.
# PAUSA_ENTRE_CLIENTES_S=15
# Cuenta de Xubio del servidor (opcional).
# XUBIO_USUARIO=
# XUBIO_CLAVE=

# --- Usuario (niveles de ContadorWeb) ---
# Secreto compartido con ContadorWeb (minimo 32 caracteres). Vacio = modo local.
# CONTROL_FCT_MODULO_SECRETO=
# SESION_HORAS=12
# USUARIO_POR_DEFECTO_NIVEL=100
